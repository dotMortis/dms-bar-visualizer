post_install() {
  cat <<'MSG'
==> Start it now and with every graphical session:
      systemctl --user enable --now bar-visualizer
==> Make the DankBar background transparent:
      DMS Settings -> Dank Bar -> Transparency = 0
==> Settings (bar geometry, intensity, ...) go in ~/.config/bar-visualizer/config.json.
    See /usr/share/doc/dms-bar-visualizer/README.md
MSG
}

post_upgrade() {
  echo '==> Restart to pick up the new version: systemctl --user restart bar-visualizer'
}
