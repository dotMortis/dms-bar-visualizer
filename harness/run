#!/bin/bash
# The replay harness: runs a visualizer as it ships, in its own qs, on a recorded input, and measures it.
#
#   harness/run [options] <scenario>
#
#   scenarios   music              the reference track (harness/kicks.mjs REFERENCE_TRACK), the Active
#                                  Player playing it; no Lyric Words
#               silence_no_player  Silence: cava's silence, no Active Player
#               silence_paused     Silence: cava's silence, the Active Player paused
#               silence_playing    Silence: cava's silence while the Active Player reports playing
#                                  (a silent track, "Silence")
#   options     --host bar     what runs: bar = the Bar Visualizer (shell.qml), the default
#               --commit REV   measure REV (e.g. v0.10.0) instead of this working tree
#               --warmup S     seconds before measuring (default 5)
#               --loops N      whole loops of the track to measure over (default 1, 24.05 s)
#               --out DIR      where logs and result.json go (default: a new /tmp/bvh-out.* dir)
#               --check-kicks  the cheap check instead of measuring: the tree's own audio pipeline
#                              on the replayed input must give the Kicks the kick-replay tests expect
#               --cpu-only     CPU alone, without the measures below (they cost about half a point)
#
#   measures    cpu            % of one core, qs + capture + children
#               frames         frames rendered and late ones (over 1.5 refreshes apart), Qt's GPU
#                              frame time (QSG_RENDER_TIMING, QSG_RHI_PROFILE in qs.log)
#               gpu            GPU busy, from the DRM driver's fdinfo
#               profile        perf.data and profile.txt: where the CPU time goes (needs perf)
#
# Only the inputs are swapped: bin/cava stands in for cava (first on PATH), player stands in for the
# Active Player (an MPRIS player on the run's own session bus, the only one there), and the run gets
# its own runtime dir, config dir (default settings), cache and session bus, so it can't see or touch
# the user's live visualizers, DMS, players or config.json. qs runs in a transient systemd scope, so
# CPU is the scope's cgroup: qs, its capture and every short-lived child (sh, pactl), as % of one
# core like htop. Everything it starts is stopped when it exits.
#
# Needs: quickshell, systemd --user with cgroup v2, dbus-run-session, busctl, node, python3 with
# python-dbus and python-gobject, qsb (qt6-shadertools). Shows the visualizer on the desktop for the
# run's length. Not a test: CPU depends on the machine and what else runs, so compare runs made
# back to back.
set -euo pipefail

HARNESS=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO=$(dirname "$HARNESS")
HOST=bar COMMIT="" WARMUP=5 LOOPS=1 OUT="" CHECK_KICKS=0 CPU_ONLY=0 SCENARIO=""

die() { echo "harness: $*" >&2; exit 2; }

while (($#)); do
    case $1 in
        --host) HOST=$2; shift ;;
        --commit) COMMIT=$2; shift ;;
        --warmup) WARMUP=$2; shift ;;
        --loops) LOOPS=$2; shift ;;
        --out) OUT=$2; shift ;;
        --check-kicks) CHECK_KICKS=1 ;;
        --cpu-only) CPU_ONLY=1 ;;
        -h | --help) sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        -*) die "unknown option $1" ;;
        *) [[ -z $SCENARIO ]] || die "one scenario at a time"; SCENARIO=$1 ;;
    esac
    shift
done
[[ -n $SCENARIO ]] || die "which scenario? (see --help)"

# --- Scenarios: the input. Each sets FIXTURE (the band stream) or SILENT=1 (cava's silence instead),
# TRACK (its name in the report), and PLAYER: the stand-in Active Player's PlaybackStatus at start
# (Playing, Paused) or none, with PLAYER_TITLE, the track it reports. It plays a track as long as the
# reference track's loop, on the same timeline. Later: the lyrics.
scenario_music() { FIXTURE=$REPO/tests/fixtures/$REFERENCE.txt SILENT=0 TRACK=$REFERENCE PLAYER=Playing PLAYER_TITLE="Steady House"; }
scenario_silence_no_player() { FIXTURE="" SILENT=1 TRACK=silence PLAYER=none PLAYER_TITLE=""; }
scenario_silence_paused() { FIXTURE="" SILENT=1 TRACK=silence PLAYER=Paused PLAYER_TITLE="Steady House"; }
# A silent track has no words: the lyrics stand-in (#46) is to answer none for "Silence".
scenario_silence_playing() { FIXTURE="" SILENT=1 TRACK=silence PLAYER=Playing PLAYER_TITLE="Silence"; }

# --- Hosts: what runs. Each sets SHELL_DIR, the qs config dir, from TREE (the code under test).
host_bar() { SHELL_DIR=$TREE; }
# The tree's own AudioPipeline in a bare shell that logs each Kick against the epoch.
host_kicks() {
    SHELL_DIR=$RUN/kicks
    mkdir -p "$SHELL_DIR"
    cat > "$SHELL_DIR/shell.qml" <<EOF
import QtQuick
import Quickshell
import "file://$TREE/audio"
ShellRoot {
    AudioPipeline {
        confPath: Quickshell.env("XDG_RUNTIME_DIR") + "/harness-kicks-cava.conf"
        onKicked: power => console.log("KICK " + (Date.now() / 1000 - Number(Quickshell.env("HARNESS_EPOCH"))).toFixed(4) + " " + power.toFixed(3))
    }
}
EOF
}

declare -F "scenario_$SCENARIO" >/dev/null || die "no scenario '$SCENARIO'"
declare -F "host_$HOST" >/dev/null || die "no host '$HOST'"
((CHECK_KICKS)) && HOST=kicks

# --- Setup ----------------------------------------------------------------------------------------
ID=bvh-$$
# Short: the Wayland socket's path in it must fit in 108 bytes.
RUN=$(mktemp -d /tmp/bvh.XXXXXX)
TREE=$REPO
OUT=${OUT:-$(mktemp -d /tmp/bvh-out.XXXXXX)}
mkdir -p "$OUT"
cleanup() {
    systemctl --user stop "$ID-qs.scope" "$ID-aux.scope" 2>/dev/null || true
    wait "${QS_JOB:-}" 2>/dev/null || true   # perf, when it wraps qs
    local p
    for p in ${PERF_QS:-}; do rm -f "/tmp/perf-$p.map"; done   # QML's JIT map, if the run failed before the report
    rm -rf "$RUN"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# systemd-run --user --scope puts the scopes here.
APP_SLICE=/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/app.slice
CG=$APP_SLICE/$ID-qs.scope

# The real node, not a version manager's shim: those read the user's config dirs, which the run swaps.
NODE=$(node -p process.execPath)
read -r REFERENCE LOOP_LENGTH < <("$NODE" --input-type=module -e "
    import { REFERENCE_TRACK, replayTrack } from '$HARNESS/kicks.mjs';
    console.log(REFERENCE_TRACK, replayTrack(REFERENCE_TRACK).length.toFixed(6));")
[[ -n ${LOOP_LENGTH:-} ]] || die "couldn't read the reference track from kicks.mjs"
"scenario_$SCENARIO"
((CHECK_KICKS && SILENT)) && die "--check-kicks needs a scenario with music"

# The code under test: this working tree, or REV exported from git (nothing in the checkout changes).
if [[ -n $COMMIT ]]; then
    REV=$(git -C "$REPO" rev-parse --verify "$COMMIT^{commit}") || die "no commit $COMMIT"
    TREE=$RUN/tree
    mkdir -p "$TREE"
    git -C "$REPO" archive "$REV" | tar -x -C "$TREE"
    TREE_DESC="$(git -C "$REPO" describe --tags --always "$REV") ($REV)"
else
    REV=$(git -C "$REPO" rev-parse HEAD)
    TREE_DESC="working tree at $(git -C "$REPO" describe --tags --always --dirty)"
fi

# What install.sh builds: the shaders (gitignored), compiled where missing or older than their source.
QSB=$(command -v qsb || echo /usr/lib/qt6/bin/qsb)
for frag in "$TREE"/shaders/*.frag "$TREE"/lock-ring/shaders/*.frag; do
    [[ -e $frag && ! ${frag}.qsb -nt $frag ]] || continue
    "$QSB" --glsl "100 es,120,150" --hlsl 50 --msl 12 -o "$frag.qsb" "$frag"
done
"host_$HOST"

# The run's own runtime dir, linking back only to the compositor, PipeWire and systemd. Pulse is
# reached by its socket: pactl refuses a symlinked pulse/ dir.
RT=/run/user/$(id -u)
for f in "${WAYLAND_DISPLAY:-wayland-1}" hypr pipewire-0 systemd; do
    [[ -e $RT/$f ]] && ln -s "$RT/$f" "$RUN/$f"
done
chmod 700 "$RUN"
mkdir -p "$RUN/config/bar-visualizer" "$RUN/cache" "$RUN/state" "$RUN/data"
echo '{}' > "$RUN/config/bar-visualizer/config.json"   # every setting at its default

export XDG_RUNTIME_DIR=$RUN XDG_CONFIG_HOME=$RUN/config XDG_CACHE_HOME=$RUN/cache \
    XDG_STATE_HOME=$RUN/state XDG_DATA_HOME=$RUN/data \
    PULSE_SERVER=unix:$RT/pulse/native PATH=$HARNESS/bin:$PATH NO_AT_BRIDGE=1 \
    HARNESS_FIXTURE=$FIXTURE HARNESS_SILENT=$SILENT HARNESS_LOOP=$LOOP_LENGTH HARNESS_LOG=$OUT/capture.log \
    HARNESS_PLAYER=$PLAYER HARNESS_PLAYER_TITLE=$PLAYER_TITLE HARNESS_PLAYER_LOG=$OUT/player.log
: > "$HARNESS_LOG"
: > "$HARNESS_PLAYER_LOG"

# The epoch: the track is at its first frame when the window opens, so every window holds the
# same whole loops; the warm-up plays the track's end.
now() { date +%s.%N; }
sleep_until() { local s; s=$(awk -v t="$1" -v n="$(now)" 'BEGIN { d = t - n; print (d > 0 ? d : 0) }'); sleep "$s"; }
export HARNESS_EPOCH=$(awk -v n="$(now)" -v w="$WARMUP" 'BEGIN { printf "%.6f", n + w }')
WINDOW=$(awk -v l="$LOOP_LENGTH" -v n="$LOOPS" 'BEGIN { printf "%.6f", l * n }')

# A private session bus, held open in its own scope with the stand-ins on it. They stand in for
# the user's session (the stand-in player for Spotify, say), so their CPU isn't the visualizer's.
systemd-run --user --scope --unit="$ID-aux" -q \
    dbus-run-session --config-file="$HARNESS/bus.conf" -- \
    sh -c 'echo "$DBUS_SESSION_BUS_ADDRESS" > "$XDG_RUNTIME_DIR/bus.addr"
           [ "$HARNESS_PLAYER" = none ] || "$0/player" &
           exec sleep infinity' "$HARNESS" \
    > "$OUT/aux.log" 2>&1 &
for _ in $(seq 50); do [[ -s $RUN/bus.addr ]] && break; sleep 0.1; done
[[ -s $RUN/bus.addr ]] || die "the private session bus didn't start (see $OUT/aux.log)"
export DBUS_SESSION_BUS_ADDRESS=$(cat "$RUN/bus.addr")
player_on_bus() { busctl --address="$DBUS_SESSION_BUS_ADDRESS" list --no-legend 2>/dev/null | grep -q '^org\.mpris\.MediaPlayer2\.harness '; }
if [[ $PLAYER != none ]]; then
    for _ in $(seq 50); do player_on_bus && break; sleep 0.1; done
    player_on_bus || die "the stand-in player didn't start (see $OUT/aux.log)"
fi

# --- Measures: set up before qs starts (optional), begin before the window, end after it, report
# after the run. ----------------------------------------------------------------------------------
pids() { cat "$CG/cgroup.procs" 2>/dev/null; }
# A short-lived child (sh, pactl) can exit while it's read: then empty, not a failed run (set -e,
# pipefail).
comm() { cat "/proc/$1/comm" 2>/dev/null || true; }
ticks() { { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null || true; } | awk '{ print $12 + $13 }'; }   # utime + stime
usage() { awk -v k="$1" '$1 == k { print $2 }' "$CG/cpu.stat"; }

measure_cpu_begin() {
    CPU_U0=$(usage usage_usec) CPU_USER0=$(usage user_usec) CPU_SYS0=$(usage system_usec) CPU_T0=$(date +%s%N)
    declare -gA TICKS0=() NAME=()
    local p
    for p in $(pids); do TICKS0[$p]=$(ticks "$p"); NAME[$p]=$(comm "$p"); done
}
measure_cpu_end() {
    CPU_U1=$(usage usage_usec) CPU_USER1=$(usage user_usec) CPU_SYS1=$(usage system_usec) CPU_T1=$(date +%s%N)
    declare -gA TICKS1=()
    local p
    for p in $(pids); do TICKS1[$p]=$(ticks "$p"); NAME[$p]=${NAME[$p]:-$(comm "$p")}; done
    CAPTURE_ALIVE=0
    for p in "${!TICKS1[@]}"; do [[ ${NAME[$p]} != cava ]] || CAPTURE_ALIVE=1; done
}
measure_cpu_report() {
    local hz ns pct user sys qs=0 cap=0 p d
    hz=$(getconf CLK_TCK) ns=$((CPU_T1 - CPU_T0))
    of_core() { awk -v u="$1" -v t="$ns" 'BEGIN { printf "%.1f", u * 1000 / t * 100 }'; }   # us over the window
    # Processes alive for the whole window, by name; whatever else ran in it (sh, pactl, a capture
    # restarted mid-window) is the rest of the total.
    for p in "${!TICKS1[@]}"; do
        [[ -n ${TICKS0[$p]:-} && -n ${TICKS1[$p]} ]] || continue
        d=$(((${TICKS1[$p]} - ${TICKS0[$p]}) * 1000000 / hz))
        case ${NAME[$p]} in qs) qs=$((qs + d)) ;; cava) cap=$((cap + d)) ;; esac
    done
    local total=$((CPU_U1 - CPU_U0))
    pct=$(of_core "$total") user=$(of_core $((CPU_USER1 - CPU_USER0))) sys=$(of_core $((CPU_SYS1 - CPU_SYS0)))
    local pqs pcap prest
    pqs=$(of_core "$qs") pcap=$(of_core "$cap") prest=$(of_core $((total - qs - cap < 0 ? 0 : total - qs - cap)))
    echo "cpu      $pct % of one core (qs + capture + children), user $user, system $sys"
    echo "         qs $pqs, capture $pcap, other (sh, pactl, ...) $prest"
    RESULT_JSON+="\"cpu_pct\": $pct, \"cpu_user_pct\": $user, \"cpu_system_pct\": $sys, \"cpu_qs_pct\": $pqs, \"cpu_capture_pct\": $pcap, \"cpu_other_pct\": $prest, "
}

# The deeper measures report through a node script each: it prints its lines and writes its
# result.json fields (one JSON object) to a file, appended here.
add_json() { local j; j=$(cat "$1"); j=${j#\{}; j=${j%\}}; [[ -z $j ]] || RESULT_JSON+="$j, "; }

# Frame timing and GPU frame time, from Qt's own render-loop log in qs.log: QSG_RENDER_TIMING logs
# each frame the render loop renders, per window, QSG_RHI_PROFILE adds the GPU's time for it
# (timestamp queries). Late is measured against the display's refresh (hyprctl).
measure_frames_setup() { export QSG_RENDER_TIMING=1 QSG_RHI_PROFILE=1; }
measure_frames_begin() { FRAMES_T0=$(now); }
measure_frames_end() { FRAMES_T1=$(now); }
measure_frames_report() {
    local monitors=()
    hyprctl -j monitors > "$RUN/monitors.json" 2>/dev/null && monitors=(--monitors "$RUN/monitors.json")
    "$NODE" "$HARNESS/frames.mjs" "$OUT/qs.log" "$FRAMES_T0" "$FRAMES_T1" "${monitors[@]}" --json "$RUN/frames.json"
    add_json "$RUN/frames.json"
}

# GPU busy: the DRM driver's per-client engine time (/proc/<pid>/fdinfo of each /dev/dri fd), for
# every process in the scope, over the window.
gpu_snapshot() {
    local p fd
    echo "time $(date +%s%N)"
    for p in $(pids); do
        for fd in /proc/"$p"/fd/*; do
            [[ $(readlink "$fd" 2>/dev/null) == /dev/dri/* ]] || continue
            echo "fdinfo $p ${fd##*/}"
            cat "/proc/$p/fdinfo/${fd##*/}" 2>/dev/null || true
        done
    done
}
measure_gpu_begin() { gpu_snapshot > "$RUN/gpu0.txt"; }
measure_gpu_end() { gpu_snapshot > "$RUN/gpu1.txt"; }
measure_gpu_report() {
    "$NODE" "$HARNESS/gpu.mjs" "$RUN/gpu0.txt" "$RUN/gpu1.txt" --json "$RUN/gpu.json"
    add_json "$RUN/gpu.json"
}

# The CPU profile: perf samples every process in the scope (qs's threads, the capture, sh, pactl)
# in the window only, user space only (all perf_event_paranoid 2 allows). perf must be qs's
# parent (ptrace_scope 1), so it wraps the launch and stays out of the scope's cgroup; its control
# fifo switches sampling on and off. QML's JIT names its functions in /tmp/perf-<pid>.map, which
# moves to the output dir after the report.
PERF=0
measure_profile_setup() {
    command -v perf >/dev/null || { echo "harness: no perf on PATH, so no CPU profile" >&2; return 0; }
    rm -f "$OUT/perf.data"   # not kept as perf.data.old
    mkfifo "$RUN/perf.ctl" "$RUN/perf.ack"
    QS_WRAP=(perf record -q -e cycles:u -F 1999 -g --user-callchains -N -D -1
        --control "fifo:$RUN/perf.ctl,$RUN/perf.ack" -o "$OUT/perf.data" --)
    export QV4_PROFILE_WRITE_PERF_MAP=1
    PERF=1
}
perf_ctl() {
    timeout 5 sh -c 'echo "$1" > "$2" && head -c 4 "$3" > /dev/null' sh "$1" "$RUN/perf.ctl" "$RUN/perf.ack" \
        || echo "harness: perf didn't $1 sampling" >&2
}
measure_profile_begin() {
    ((PERF)) || return 0
    local p
    PERF_QS=""
    for p in $(pids); do if [[ $(comm "$p") == qs ]]; then PERF_QS+=" $p"; fi; done
    perf_ctl enable
}
measure_profile_end() { ((PERF)) || return 0; perf_ctl disable; }
measure_profile_report() {
    ((PERF)) || return 0
    wait "$QS_JOB" 2>/dev/null || true   # perf writes perf.data once qs is gone
    local report=(perf report -i "$OUT/perf.data" --stdio --no-children -g none)
    "${report[@]}" -q --sort comm,dso -F sample,period,comm,dso --percent-limit 0 -t $'\t' > "$RUN/parts.tsv" 2>/dev/null
    "$NODE" "$HARNESS/profile.mjs" "$RUN/parts.tsv" --json "$RUN/profile.json" > "$RUN/parts.txt"
    {
        cat "$RUN/parts.txt"
        echo; "${report[@]}" --sort comm,dso 2>/dev/null
        echo; "${report[@]}" --sort comm,dso,sym --percent-limit 0.2 2>/dev/null
    } > "$OUT/profile.txt"
    if command -v inferno-flamegraph >/dev/null && command -v inferno-collapse-perf >/dev/null; then
        perf script -i "$OUT/perf.data" 2>/dev/null | inferno-collapse-perf | inferno-flamegraph > "$OUT/profile.svg" || true
    fi
    local p
    for p in $PERF_QS; do if [[ -e /tmp/perf-$p.map ]]; then mv "/tmp/perf-$p.map" "$OUT/"; fi; done
    cat "$RUN/parts.txt"
    echo "         $OUT/perf.data, $OUT/profile.txt"
    add_json "$RUN/profile.json"
}

MEASURES=(cpu frames gpu profile)
((CPU_ONLY || CHECK_KICKS)) && MEASURES=(cpu)

# --- The run --------------------------------------------------------------------------------------
QS_WRAP=()
for m in "${MEASURES[@]}"; do
    if declare -F "measure_${m}_setup" > /dev/null; then "measure_${m}_setup"; fi
done
"${QS_WRAP[@]}" systemd-run --user --scope --unit="$ID-qs" -q qs -p "$SHELL_DIR" --no-color --log-times > "$OUT/qs.log" 2>&1 &
QS_JOB=$!

LOAD=$(cut -d' ' -f1-3 /proc/loadavg)
sleep_until "$HARNESS_EPOCH"
[[ -n $(pids) ]] || die "qs isn't running (see $OUT/qs.log)"
for m in "${MEASURES[@]}"; do "measure_${m}_begin"; done
sleep_until "$(awk -v e="$HARNESS_EPOCH" -v w="$WINDOW" 'BEGIN { printf "%.6f", e + w }')"
for m in "${MEASURES[@]}"; do "measure_${m}_end"; done
# A short tail so the window's last Kicks reach the log.
((CHECK_KICKS)) && sleep 0.3
PLAYER_ALIVE=0
[[ $PLAYER == none ]] || ! player_on_bus || PLAYER_ALIVE=1
systemctl --user stop "$ID-qs.scope" "$ID-aux.scope" 2>/dev/null || true

STARTS=$(grep -c '^start' "$HARNESS_LOG" || true)
echo "harness  $SCENARIO on $HOST, $TREE_DESC"
echo "window   $LOOPS x $TRACK ($WINDOW s) after a ${WARMUP} s warm-up, load avg $LOAD"
((CAPTURE_ALIVE)) || { echo "FAILED: the capture wasn't running at the end of the window (see $OUT/capture.log, $OUT/qs.log)"; exit 1; }
echo "capture  alive, started $STARTS time(s)$( ((SILENT)) && echo ", silent")"
# The stand-in is the only player on the run's bus, so the visualizer reading it means it's the
# Active Player (AudioPipeline.updateActivePlayer takes the only player there is).
READS=$(grep -c ' Get' "$HARNESS_PLAYER_LOG" || true)
if [[ $PLAYER == none ]]; then
    echo "player   none"
else
    ((PLAYER_ALIVE)) || { echo "FAILED: the stand-in player wasn't on the bus at the end of the window (see $OUT/aux.log)"; exit 1; }
    ((READS)) || { echo "FAILED: the visualizer never read the stand-in player (see $OUT/player.log, $OUT/qs.log)"; exit 1; }
    echo "player   $PLAYER \"$PLAYER_TITLE\", the Active Player (read $READS time(s))"
fi

if ((CHECK_KICKS)); then
    "$NODE" "$HARNESS/kicks.mjs" "$OUT/qs.log" "$LOOPS" "$REFERENCE"
    exit
fi

RESULT_JSON="{\"scenario\": \"$SCENARIO\", \"host\": \"$HOST\", \"commit\": \"$REV\", \"tree\": \"$TREE_DESC\", \"track\": \"$TRACK\", \"player\": \"$PLAYER\", \"player_title\": \"$PLAYER_TITLE\", \"window_s\": $WINDOW, \"warmup_s\": $WARMUP, \"loadavg\": \"$LOAD\", \"capture_starts\": $STARTS, "
for m in "${MEASURES[@]}"; do "measure_${m}_report"; done
echo "${RESULT_JSON%, }}" > "$OUT/result.json"
echo "out      $OUT"
