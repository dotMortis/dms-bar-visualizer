#!/usr/bin/python3 -I
# The harness's stand-in for the DMS socket (ADR 0006): $XDG_RUNTIME_DIR/dms-<its pid>.sock, in the
# run's own runtime dir, so the Bar Visualizer finds it (its pid alive) and never the live DMS.
# Newline-delimited JSON, as DMS speaks it: a hello listing the lyrics capability on connect, then
# lyrics.get answered from harness/lyrics.json for the reference track (its title in
# harness/reference.json, what the stand-in player plays), and found: false for any other (the silent track, "Silence"). Nothing it
# answers comes from the network, whatever allowNetwork asks for.
#
# Env: XDG_RUNTIME_DIR   where the socket goes
#      HARNESS_DMS_LOG   a file every request is logged to, with "-> found" or "-> none"
import json
import os
import socket
import threading
import time

HERE = os.path.dirname(os.path.abspath(__file__))
with open(os.path.join(HERE, "reference.json")) as f:
    LYRICS_TITLE = json.load(f)["title"]  # the reference track's
with open(os.path.join(HERE, "lyrics.json")) as f:
    LYRICS = json.load(f)
log_path = os.environ.get("HARNESS_DMS_LOG")
log_lock = threading.Lock()


def log(what):
    if log_path:
        with log_lock, open(log_path, "a") as f:
            f.write(f"{time.time():.3f} {what}\n")


def answer(request):
    if request.get("method") != "lyrics.get":
        return {"id": request.get("id"), "error": "unknown method"}
    if (request.get("params") or {}).get("title") == LYRICS_TITLE:
        result = {"found": True, "synced": LYRICS, "plain": "\n".join(line["x"] for line in LYRICS)}
    else:
        result = {"found": False, "synced": [], "plain": ""}
    result.update({"instrumental": False, "voices": {}})
    return {"id": request.get("id"), "result": result}


def serve(conn):
    with conn, conn.makefile("rw") as stream:
        stream.write(json.dumps({"apiVersion": 38, "capabilities": ["lyrics"]}) + "\n")
        stream.flush()
        for line in stream:
            try:
                request = json.loads(line)
            except ValueError:
                continue
            reply = answer(request)
            found = "found" if reply.get("result", {}).get("found") else "none"
            log(f"{request.get('method')} {json.dumps(request.get('params'))} -> {found}")
            stream.write(json.dumps(reply) + "\n")
            stream.flush()


server = socket.socket(socket.AF_UNIX)
server.bind(os.path.join(os.environ["XDG_RUNTIME_DIR"], f"dms-{os.getpid()}.sock"))
server.listen()
while True:
    conn, _ = server.accept()
    threading.Thread(target=serve, args=(conn,), daemon=True).start()
